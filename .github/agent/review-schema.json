{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings"],
  "properties": {
    "verdict": { "type": "string", "enum": ["approve", "request_changes"] },
    "summary": {
      "type": "string",
      "description": "Two to five sentences: what the change does, whether it resolves the issue, overall risk."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line", "title", "body"],
        "properties": {
          "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "file": { "type": "string" },
          "line": { "type": ["integer", "null"] },
          "title": { "type": "string" },
          "body": {
            "type": "string",
            "description": "What is wrong, the concrete scenario that triggers it, and the fix."
          }
        }
      }
    }
  }
}
